
#!/bin/sh
echo "🔍 Running pre-commit checks..."

# Check if package-lock.json was created and remove it
if [ -f "package-lock.json" ]; then
  echo "🚫 Detected package-lock.json - removing it (use bun instead of npm)"
  rm package-lock.json
fi

# Check if yarn.lock was created and remove it
if [ -f "yarn.lock" ]; then
  echo "🚫 Detected yarn.lock - removing it (use bun instead of yarn)"
  rm yarn.lock
fi

# Run biome format to auto-fix formatting
echo "🎨 Running biome format..."
bunx biome format --write

git add .

# Run biome check to verify no errors remain
echo "🔍 Running biome check for errors..."
bunx biome check
